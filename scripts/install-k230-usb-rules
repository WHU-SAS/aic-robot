#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then
    echo "Run with sudo: sudo $0" >&2
    exit 1
fi
aic_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
getent group plugdev >/dev/null
install -m 0644 "$aic_root/configs/k230/60-aic-k230.rules" /etc/udev/rules.d/60-aic-k230.rules
udevadm control --reload-rules
udevadm trigger --subsystem-match=usb --attr-match=idVendor=29f1 --attr-match=idProduct=0230 --action=change
echo 'K230 USB access rules installed; no firmware has been written.'
