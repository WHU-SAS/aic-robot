#!/bin/sh
set -eu
aic_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$aic_root"
if [ -x "$aic_root/.venv-host/bin/python" ]; then
    exec env -u PYTHONPATH PYTHONPATH="$aic_root" "$aic_root/.venv-host/bin/python" "$@"
fi
exec env -u PYTHONPATH PYTHONPATH="$aic_root" /usr/bin/python3 "$@"
